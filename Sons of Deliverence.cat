    <profile name="Rapid Flight" id="2065-6b8d-9af2-d0ea" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">When this model makes a shooting attack, it suffers a -1 to its Hit Rolls. When this model makes a Hazardous test, it must roll a number of dice equal to its remaining wounds.</characteristic>
      </characteristics>
