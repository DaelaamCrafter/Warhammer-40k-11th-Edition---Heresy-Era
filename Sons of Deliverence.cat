  <sharedProfiles>
    <profile name="Guided Slaughter" id="0c62-ff4d-1125-850b" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">• While a Shadow Killer unit is within 6” of this model, it gains adds 2 to Charge rolls and may reroll charge rolls.


• While a Shadow Killer unit is within 6” of this model, melee weapons equipped by models in that unit gain Lance</characteristic>
      </characteristics>
    </profile>
    <profile name="Leader" id="8a29-469c-1619-2658" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <comment>Shadow Warden</comment>
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">This model can be attached to the following units:
• Shadow Killers</characteristic>
      </characteristics>
    </profile>
    <profile name="Death on Black Wings" id="34b7-3c9a-8cf7-0d03" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">When a model in this unit makes a melee attack targeting your Priority Target, those attacks gain Precision and may re-roll Wound rolls of 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Slaughter the Weak" id="e5f7-5598-a7c2-0052" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Each time a model in this unit makes a melee attack, if this unit made a Charge move this turn, weapons equipped by models in this unit gain Cleave 1. If a weapon equipped by a model in this unit already has Cleave (X). Improve the X Characteristic of the Cleave by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Target Sighted" id="a421-783b-c627-1fd0" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Each time this unit Remains Stationary, until the start of your next Movement phase, ranged attacks made by this unit against your Priority Target have the Devastating Wounds keyword.</characteristic>
      </characteristics>
    </profile>
    <profile name="Fatal Strike" id="f9c1-e290-7cd7-1242" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Once per game, weapons equipped by models in this unit score Critical Hits and Critical Wounds on a 5+</characteristic>
      </characteristics>
    </profile>
    <profile name="Sable Brand" id="f22d-fcfb-61bf-df45" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Each time a model in this unit makes a melee attack, you can re‑roll the Hit roll This unit cannot be selected to Fall Back and models in this unit have a Maximum OC of 0. This unit can never contest or claim an objective.</characteristic>
      </characteristics>
    </profile>
    <profile name="Stealth Field" id="1055-33ed-9cec-f4b3" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">This model has a 4+ Invulnerable Save and cannot be targeted by Snap Shooting.</characteristic>
      </characteristics>
    </profile>
    <profile name="Whispercutter" id="ee71-dd6f-5be8-da4f" hidden="false" typeId="1489-fff5-b9e1-c4a3" typeName="Unit">
