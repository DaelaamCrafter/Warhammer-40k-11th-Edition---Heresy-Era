  <sharedProfiles>
    <profile name="Adamantine Will" id="1e95-8293-1388-ccbc" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">This model has a 4+ Feel No Pain versus Mortal Wounds and Psychic.</characteristic>
      </characteristics>
    </profile>
    <profile name="Champion of the Inner Circle" id="d166-1dfe-de0a-3b4a" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">If this model is attached to an Inner Circle Knights Cenobium unit, that unit may select a second Order of the Hekatonystika to be active during the game.</characteristic>
      </characteristics>
    </profile>
    <profile name="Leader" id="cbab-e3ac-deb6-ed32" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <comment>Paladin of the Hekatonystika</comment>
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">This model can be attached to the following units:
• Inner Circle Knights Cenobium
• Terminator Squad</characteristic>
      </characteristics>
    </profile>
    <profile name="Honour or Death" id="9d68-adda-179e-ac78" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">While this unit contains a Deathwing Strikemaster, this unit gains Deep Strike and you can target this unit with the Heroic Intervention Stratagem for 0CP.</characteristic>
      </characteristics>
    </profile>
    <profile name="Kingslayers" id="97e8-6f22-af00-8d56" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Weapons equipped by models in this unit gain Anti-Character 5+</characteristic>
      </characteristics>
    </profile>
    <profile name="Instigator Bolt Carbine" id="d507-e94e-36c9-b5ee" hidden="false" typeId="2ff9-37cc-0c8a-1572" typeName="Ranged Weapons">
      <characteristics>
