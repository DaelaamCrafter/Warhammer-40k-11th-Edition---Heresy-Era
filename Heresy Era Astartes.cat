    <profile name="Witchfire" id="4c85-bd05-2be5-d78f" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-1</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">During the Shooting Phase, you may use the Witchfire Psychic Weapon. If the result of the Psychic test was 11 or greater, the weapon gains Anti-Psyker 4+ and Anti-Daemon 4+</characteristic>
      </characteristics>
    </profile>
    <profile name="Ghostly Bonds" id="017e-d593-415c-5e65" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-1</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">Select one enemy unit within 18&quot; of and visible to this Psyker. Until the start of your next Psychic phase, halve that unit’s Move characteristic.</characteristic>
      </characteristics>
    </profile>
    <profile name="Hammerhand" id="9054-ce90-87ca-4707" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">0</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">Models in this unit may reroll melee wound rolls of 1. If the enemy unit is a Psyker or Daemon unit, you can reroll the wound roll instead</characteristic>
      </characteristics>
    </profile>
    <profile name="Purifying Flame" id="aa61-ee48-913b-df16" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-2</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">The closest enemy unit within 9&quot; of and visible to this Psyker suffers 3 mortal wounds. If that unit was a Psyker or Daemon unit, it suffers D3+3 mortal wounds instead.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sanctuary" id="4757-1f51-8d97-b598" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
