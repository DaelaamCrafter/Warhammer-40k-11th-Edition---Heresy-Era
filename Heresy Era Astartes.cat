      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Models in the bearer’s unit have a 5+ Feel No Pain. At the start of the Command Phase this unit heals 1D3+1 Wounds</characteristic>
      </characteristics>
    </profile>
    <profile name="Art of Destruction" id="ba63-59c9-a43a-faee" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Each time a model in this unit makes an attack that targets a Monster, Vehicle, or Fortification unit, improve the Strength, Armour Penetration and Damage characteristics of that attack by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Master Sniper" id="1450-0b1f-9737-ce61" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Each time this model makes an attack with the Nemesis Rifle that targets a Character unit, you can re-roll one Hit roll, Wound roll, and Damage roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dead-Shot" id="ffb6-1a64-aabd-0c21" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Each time this model makes a ranged attack, when selecting targets for that attack, you can ignore the Lone Operative ability.</characteristic>
      </characteristics>
    </profile>
