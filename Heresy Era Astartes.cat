      </characteristics>
    </profile>
    <profile name="Guerilla Tactics" id="2ea7-09fe-d56c-5e3e" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">At the end of your opponent’s turn, if this unit is more than 6&quot; away from all enemy models, you can remove this unit from the battlefield and place it into Strategic Reserves.</characteristic>
      </characteristics>
    </profile>
    <profile name="Leader" id="0d0f-4f25-7048-6e35" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
