    <profile name="Cobbled Together" id="e319-155f-93f0-6cac" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Each time an attack targets this model, if the Strength characteristic of that attack is greater than this model&apos;s Toughness characteristic, you can re-roll saving throws of 1 made against that attack</characteristic>
      </characteristics>
    </profile>
