    <profile name="Agile" id="b94d-7f9c-1be7-5763" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Each time this model makes a Normal, Advance or Fall Back move, it can move over sections of terrain features that are 3&quot; or less in height. However, when doing so model in this unit cannot benefit from Heavy</characteristic>
      </characteristics>
    </profile>
    <profile name="We Stand Here!" id="d33f-0b42-66e7-7cd1" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">If this unit does not move during the Movement Phase, this unit has the benefit of cover until the start of the player’s next turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Slow and Steady" id="eb74-16c0-9d2b-a6d7" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">This unit subtracts 2 from all Advance and Charge rolls (to a minimum of 1)</characteristic>
      </characteristics>
    </profile>
    <profile name="MK II &quot;Crusade&quot; Power Armor" id="2752-611e-a624-b6f8" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">5” Movement, 3+ Save, If any models in the unit are equipped with this Armor, this unit gains Slow but Steady</characteristic>
      </characteristics>
    </profile>
    <profile name="MK III &quot;Iron&quot; Power Armor" id="04e9-8085-1809-7855" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">5” Movement, 3+ Save, If any models in the unit are equipped with this Armor, this unit gains Slow but Steady. If all models are equipped with this Armor, this unit gains We Stand Here.</characteristic>
      </characteristics>
    </profile>
    <profile name="MK V &quot;Heresy&quot; Power Armor" id="579f-541c-2b59-1a9c" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
