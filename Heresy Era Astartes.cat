    <profile name="Biomantic Slam" id="ac25-c2db-f089-19a6" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-1</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">During the Fight Phase, you may use the Biomantic Slam Psychic Weapon. If the result of the Psychic test was more than 11, you may reroll the damage roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Conflagration" id="aa75-da6f-383b-6c4c" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-1</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">During the Fight Phase, you may use the Conflagration Psychic Weapon. If the result of the Psychic Test was more than 10, the weapon gains Sustained Hits 1</characteristic>
      </characteristics>
    </profile>
    <profile name="Cursed Whispers" id="6b5c-c291-54a8-9baf" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-1</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">During the Shooting Phase, you may use Cursed Whispers Psychic Weapon. If the result of the Psychic test was more than 11, the weapon gains Blast 1</characteristic>
      </characteristics>
    </profile>
    <profile name="Synapse Breaker" id="5b16-ba86-95ae-083c" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">0</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">During the Shooting Phase, you may use the Synapse Breaker Psychic Weapon. If the result of the Psychic test was more than 10, this weapon gains Anti-Infantry 3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Void Darts" id="5d2c-d768-7438-15cc" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">0</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">During the Shooting Phase, you may use the Void Darts Psychic Weapon. If the result of the Psychic Test was more than 9, this weapon improves its Strength, AP, and Damage by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Smite" id="8f3c-5788-c696-bf5d" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">0</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">The closest visible enemy unit within 18&quot; suffers D3 mortal wounds. If the result of the Psychic test was more than 11, the target suffers D6 mortal wounds instead.</characteristic>
      </characteristics>
    </profile>
    <profile name="Divination" id="108d-fe8a-86e7-e383" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-3</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">Select one enemy unit within 12”. Models in the Psykers unit ignore Invulnerable Saves against the target enemy unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Fortify" id="5a5a-7a2b-65ae-2d4b" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-1</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">Select one friendly fortification model within 12&quot; of the Psyker; that model regains up to D3 lost wounds</characteristic>
      </characteristics>
    </profile>
    <profile name="Might of Heroes" id="21e1-cfac-933d-3254" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-2</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">Select one friendly unit within 12&quot; of this Psyker. Until the start of your next Psychic phase, add 1 to that unit&apos;s Strength, Toughness, and Attacks characteristics</characteristic>
      </characteristics>
    </profile>
    <profile name="Neural Void" id="81b3-5d31-1684-0319" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-1</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">Select one enemy unit within 18” of the Psyker. Subtract 1 from the Attacks characteristic of models in that unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Psychic Fortress" id="1450-0308-b4d7-fde7" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-1</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">Until the start of your next turn while a friendly unit is within 6&quot; of this Psyker, models in that unit have a 5+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Quickening" id="6887-aa16-52a9-3284" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-2</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">Add D3 to the Attacks Characteristic of all weapons equipped by this Psyker.</characteristic>
      </characteristics>
    </profile>
    <profile name="Resurrection" id="46d4-51b8-6abf-7183" hidden="false" typeId="dfdb-f3a1-c2dd-e0b6" typeName="Psychic Powers">
      <characteristics>
        <characteristic name="Difficulty" typeId="e800-787f-7491-ed2e">-3</characteristic>
        <characteristic name="Description" typeId="59cb-e861-360c-a7aa">Return D3 Models to your unit. If models in the unit have 4 or more wounds, instead return 1 model to the unit.</characteristic>
      </characteristics>
    </profile>
