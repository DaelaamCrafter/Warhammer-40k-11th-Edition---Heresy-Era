            <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
          </costs>
          <rules>
            <rule name="Divide and Conquer" id="4c37-cce4-ec91-32b1" hidden="false">
              <description>At the start of the Declare Battle Formations step, before any units have been set up, Adeptus Astartes units with the Battleline keyword can be split into two units, each an equal number of models. If the original unit had fewer than 10 models, it cannot be split into combat squads.</description>
            </rule>
          </rules>
        </selectionEntry>
