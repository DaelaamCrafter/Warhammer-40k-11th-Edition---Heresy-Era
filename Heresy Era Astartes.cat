      </categoryLinks>
      <constraints>
        <constraint id="23da-d33f-3805-f52e" field="selections" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="20be-ecfe-ceea-c787" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Battle-Companies of the Astartes" id="33c2-0862-b2e9-ebdf" hidden="false" import="true" type="upgrade">
          <categoryLinks>
            <categoryLink name="Purge the Foe" id="3dc6-4573-c752-f01a" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
            <categoryLink name="3DP Detachment" id="2bc1-37bc-f50b-0a74" hidden="false" primary="false" targetId="7d80-2de5-816e-9d2b"/>
          </categoryLinks>
          <constraints>
            <constraint id="6ce4-2133-4094-0db8" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d87f-c69d-d5cb-8cf7" field="selections" includeChildSelections="false" scope="self" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="3"/>
            <cost name="Enhancements" typeId="f759-1bc4-cb3a-f0d2" value="0"/>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="0"/>
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
            <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
          </costs>
          <rules>
            <rule name="Company Doctrine" id="93fd-6c6a-e991-724a" hidden="false">
              <description>At the start of the first battle round, select one of the following Company Doctrines to apply to all models in your army until the end of the battle.


• 2nd Company: Adeptus Astartes Infantry units gain Feel No Pain 5+ against Mortal Wounds.
• 3rd Company: At the start of your Command phase, select one unit from your opponent’s army. Until the start of your next Command phase, each time a model in a Adeptus Astartes Character unit from your army makes an attack that targets that enemy unit, add 1 to the Wound roll.
• 4th Company: Once per game, select one unit that is in Strategic Reserves. That unit gains the Deep Strike keyword.
• 5th Company: Adeptus Astartes Infantry units from your army are eligible to shoot or declare a charge in a turn in which they Advanced.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="2nd Company" id="749c-2629-bae7-7a23" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4c5d-c46c-ab85-4ede" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <modifiers>
                <modifier affects="self.entries.forces.recursive.cf47-a0d7-7207-29dc" field="add-info" scope="roster" type="add" value="faec-8b1b-5a21-0087"/>
              </modifiers>
              <rules>
                <rule name="2nd Company" id="44cf-5ded-5dad-f4ec" hidden="false">
                  <description>Adeptus Astartes Infantry units gain Feel No Pain 5+ against Mortal Wounds.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="3rd Company" id="ba5c-fc8a-6112-6ba0" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5ee1-fad2-d01a-b27b" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="3rd Company" id="8706-cb4f-7b7c-b31c" hidden="false">
                  <description>At the start of your Command phase, select one unit from your opponent’s army. Until the start of your next Command phase, each time a model in a Adeptus</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="5th Company" id="2d14-209f-be19-bff7" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dba7-1ff6-8e15-688f" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="5th Company" id="08ce-59bd-20fe-1781" hidden="false">
                  <description>Adeptus Astartes Infantry units from your army are eligible to shoot or declare a charge in a turn in which they Advanced.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="4th Company" id="7003-606a-cd84-e0a5" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7879-6b0e-ff5d-6e2a" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="4th Company" id="90ac-799b-092e-7c68" hidden="false">
                  <description>Once per game, select one unit that is in Strategic Reserves. That unit gains the Deep Strike keyword.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
