      </characteristics>
    </profile>
    <profile name="Self Repair" id="a80f-c87a-25cb-91ea" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">At the end of your Command phase, this model regains 1 lost wound.</characteristic>
      </characteristics>
    </profile>
