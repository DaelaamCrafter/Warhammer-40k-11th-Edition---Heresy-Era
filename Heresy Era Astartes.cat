    <profile name="Close the Gap" id="e3bf-7299-2588-e885" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">If this unit is eligible to move during the movement phase, and has not done so, you may choose to give them the Assault keyword. If you do so, this unit is not eligible to charge.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bitter Duty" id="79a8-7fe5-feb5-cd63" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Models in this unit have a 5+ Feel No Pain</characteristic>
      </characteristics>
    </profile>
    <profile name="Kraken Bolter (Default)" id="bdc3-cae1-b7d1-6910" hidden="false" typeId="2ff9-37cc-0c8a-1572" typeName="Ranged Weapons">
      <characteristics>
        <characteristic name="Range" typeId="c8ea-38db-c0c8-4da1">30&quot;</characteristic>
        <characteristic name="A" typeId="6dfb-9f47-24fd-83bd">2</characteristic>
