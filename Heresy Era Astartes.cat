    <profile name="Machinator Array (Melta)" id="cbce-8d81-1172-c0a7" hidden="false" typeId="2ff9-37cc-0c8a-1572" typeName="Ranged Weapons">
      <characteristics>
        <characteristic name="Range" typeId="c8ea-38db-c0c8-4da1">12&quot;</characteristic>
        <characteristic name="A" typeId="6dfb-9f47-24fd-83bd">1</characteristic>
