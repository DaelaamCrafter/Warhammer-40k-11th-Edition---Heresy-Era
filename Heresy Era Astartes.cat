        <characteristic name="Keywords" typeId="893f-9000-ccf7-648e">Anti-Vehicle 2+</characteristic>
      </characteristics>
    </profile>
    <profile name="Spatha Combat Bike" id="232d-bf7c-0591-53f0" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">+6” Movement, +1 Toughness, +1 Wound, +Twin-Linked Bolter, Changes from Infantry to Mounted, Bulky (3)</characteristic>
      </characteristics>
    </profile>
    <profile name="Scimitar Jetbike" id="cb30-0641-705c-d4db" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">+6” Movement, +1 Toughness, +1 Wound, +Heavy Bolter, Changes from Infantry to Mounted, Fly, Deep Strike, Bulky (3)</characteristic>
      </characteristics>
    </profile>
    <profile name="Adamantine Mantle" id="a461-0167-7013-329c" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an attack is allocated to the bearer, subtract 1 from the Damage characteristic of that attack. If that attack was made with a Melta or Torrent weapon, change the Damage characteristic of that attack to 1 instead.</characteristic>
      </characteristics>
    </profile>
    <profile name="Artificer" id="bd25-4304-dbf7-3ba6" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per phase, when shooting or fighting with this weapon, you can re-roll one Hit roll, one Wound roll, or one Damage roll made with this weapon.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cyber-Familiar" id="6404-3af5-9b41-3de6" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model improves its Invulnerable Save by 1 (to a Maximum of 3+)</characteristic>
      </characteristics>
    </profile>
    <profile name="Ghostweave Cloak" id="8250-0223-faac-2f81" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The bearer has the Stealth and Lone Operative abilities.</characteristic>
      </characteristics>
    </profile>
    <profile name="Master-Crafted" id="f9ad-726f-4257-2312" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Improve the Damage Characteristic of this weapon by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Meltabomb" id="7699-1919-43bf-9fdf" hidden="false" typeId="2ff9-37cc-0c8a-1572" typeName="Ranged Weapons">
      <characteristics>
        <characteristic name="Range" typeId="c8ea-38db-c0c8-4da1">4&quot;</characteristic>
        <characteristic name="A" typeId="6dfb-9f47-24fd-83bd">1</characteristic>
        <characteristic name="BS" typeId="0583-6d2b-9bfd-8dd1">3+</characteristic>
        <characteristic name="S" typeId="ce88-5065-4411-a07a">10</characteristic>
        <characteristic name="AP" typeId="1f4b-4921-cf9d-d34c">-3</characteristic>
        <characteristic name="D" typeId="738c-123b-f9bb-5f4e">2D3+2</characteristic>
        <characteristic name="Keywords" typeId="893f-9000-ccf7-648e">Blast 1, One-Shot</characteristic>
      </characteristics>
    </profile>
    <profile name="Orbital Uplink Reliquary" id="ddb3-3942-c43a-144c" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After both players have deployed their armies, you may select one Adeptus Astartes unit from your army and redeploy them. When doing so, you can set that unit up in Strategic Reserves if you wish, regardless of how many units are already in Strategic Reserves.</characteristic>
      </characteristics>
    </profile>
    <profile name="Teleport Homer" id="226c-b6e9-f6d8-2df0" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Models in the bearer&apos;s unit gain the Deep Strike special rule. At the start of the battle, you can set up one Teleport Homer token for this unit anywhere on the battlefield that is not in your opponent’s deployment zone. If you do, once per battle, you can target this unit with the Rapid Ingress Stratagem for 0CP, but when resolving that Stratagem, you must set this unit up within 3&quot; of that token and not within 9&quot; of any enemy models. That token is then removed</characteristic>
      </characteristics>
    </profile>
    <profile name="Praetor" id="7efe-0e33-38c8-c00e" hidden="false" typeId="1489-fff5-b9e1-c4a3" typeName="Unit">
      <characteristics>
        <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6&quot;</characteristic>
        <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">5</characteristic>
        <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
        <characteristic name="W" typeId="750a-a2ec-90d3-21fe">6</characteristic>
        <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
        <characteristic name="WP" typeId="506f-ea74-60a7-70d5">-</characteristic>
        <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
        <characteristic name="InSv" typeId="a428-7a31-d4d7-43fb">-</characteristic>
      </characteristics>
    </profile>
    <profile name="Ancient Fortitude" id="4f80-33e2-280a-e5f0" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">Each time an attack is allocated to this model, halve the Damage characteristic of that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Master of the Legion" id="94d7-9ac5-535a-9fce" hidden="false" typeId="b139-9a8a-94a3-bdc7" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="6468-b66d-4509-c7d6">If a model with this special rule is your Warlord, at the start of your Command phase you gain 1 CP.</characteristic>
      </characteristics>
    </profile>
    <profile name="Iron Halo" id="9dd4-02f8-5e46-207f" hidden="false" typeId="a8b2-cae8-0cb2-0c83" typeName="Equipment">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">4+ Invulnerable Save</characteristic>
      </characteristics>
    </profile>
