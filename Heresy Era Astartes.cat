              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Distress Signal" id="3a68-5169-2609-4283" hidden="false">
              <description>The first time each battle round that a friendly Hammers of Caliban unit arrives from Strategic Reserves, that unit can immediately make a Normal move of up to D3&quot;. This move cannot end within Engagement Range of one or more enemy units.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Fangs of Caliban" id="649a-aabb-35ec-b0e5" hidden="false" import="true" type="upgrade">
          <categoryLinks>
            <categoryLink name="Reconnaissance" id="6c35-503d-520e-93bd" hidden="false" primary="false" targetId="b4a7-5083-fe94-4d24"/>
          </categoryLinks>
          <constraints>
            <constraint id="fb78-7dfe-8ab3-eede" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <displayCosts>
            <displayCost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
          </displayCosts>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="a1db-1fab-ba50-b907" childName="Hammers of Caliban (Dark Angels Successor)" field="selections" scope="primary-catalogue" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Tighten the Noose" id="32a5-dd80-59f2-5d9d" hidden="false">
              <description>• At the start of each Fight phase, friendly Hammers of Caliban Infantry or Mounted units gain Fight First in that phase if they are engaged in melee with an enemy unit and either:
o Outnumber the enemy models within engagement range (Terminators models count as 2, Mounted models count as 3)
o Two or more Hammers of Caliban units are engaged with the same enemy unit.


• Any enemy unit that was charged this turn loses Fight First until the start of their next turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Condemned to Wander" id="ec38-eb21-773b-2940" hidden="false" import="true" type="upgrade">
          <categoryLinks>
            <categoryLink name="Disruption" id="a85c-59b5-bf89-f129" hidden="false" primary="false" targetId="ecf8-cf72-7d5b-1b5b"/>
          </categoryLinks>
          <constraints>
            <constraint id="a473-67f0-94f5-d9e9" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
            <cost name="Enhancements" typeId="f759-1bc4-cb3a-f0d2" value="0"/>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="0"/>
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
            <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
          </costs>
          <rules>
            <rule name="Condemned to Wander" id="3289-834a-f576-1e93" hidden="false">
              <description>If your Army Faction is not Exiles, but every model in your army has the Imperium keyword, you can select this detachment. While playing this detachment, you may include Exile units in your army. The maximum number of Exile units you can include in your army depends on the battle size, as shown below.


Models with the Faction: Exiles Keyword gain the following benefit:
Condemned to Wander: Each time an Exiles unit from your army (excluding Vehicles) makes an attack, if there are no other friendly units within 6&quot; of that unit, add 1 to the Hit roll and add 1 to the Wound roll.


Incursion: 2 Character Models, 2 Non-Character Units per Character Model, 250 Maximum Points
Strike Force: 3 Character Models, 2 Non-Character Units per Character Model, 500 Maximum Points</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
